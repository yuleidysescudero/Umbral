---
import '../styles/global.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/montserrat/latin-900.css';
import '@fontsource/atkinson-hyperlegible/latin-400.css';
import '@fontsource/atkinson-hyperlegible/latin-700.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Umbral × TVN · Agenda editorial',
  description = 'Umbral × TVN: agenda editorial priorizada, evidencia trazable y borradores para revisión humana. Prototipo de hackIAthon para TVN Media.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#110862" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/brand/social.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/brand/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/brand/favicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/brand/icon-256.png" />
    <title>{title}</title>
    <script is:inline>
      // Tema antes de pintar (sin parpadeo). localStorage puede fallar: siempre con try/catch.
      try {
        if (localStorage.getItem('umbral.theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
